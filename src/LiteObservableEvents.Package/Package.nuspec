  <metadata>
    <id>LiteObservableEvents</id>
    <version>1.0.0-beta2</version>
    <authors>ema</authors>
    <owners>ema</owners>
    <icon>Logo.png</icon>
    <license type="expression">MIT</license>
    <readme>README.md</readme>
    <projectUrl>https://github.com/emako/LiteObservableEvents</projectUrl>
    <repository type="git" url="https://github.com/emako/LiteObservableEvents" />
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <description>Lightweight observable event hub and source-generated event bridges for .NET, with optional weak-reference (holder) lifecycle and MVVM-style interactions.</description>
    <releaseNotes>https://github.com/emako/LiteObservableEvents/releases</releaseNotes>
    <copyright>Copyright (c) 2026 LiteObservableEvents contributors</copyright>
    <tags>LiteObservableEvents ObservableEvents MVVM Event Rx EventHub Rx-EventHub RxUI Rx-UI</tags>
