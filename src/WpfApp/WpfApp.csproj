<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <LangVersion>preview</LangVersion>
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
    <MyNuGetFlag>false</MyNuGetFlag>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0"/>
  </ItemGroup>

  <ItemGroup Condition="'$(MyNuGetFlag)' == 'true'">
    <PackageReference Include="LiteObservableEvents" Version="1.0.0"/>
  </ItemGroup>

  <ItemGroup Condition="'$(MyNuGetFlag)' == 'false'">
    <ProjectReference Include="..\LiteObservableEvents\LiteObservableEvents.csproj"/>
    <ProjectReference Include="..\LiteObservableEvents.SourceGenerator\LiteObservableEvents.SourceGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false"/>
  </ItemGroup>
</Project>